{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDisabled",
    ":gitSignOff",
    ":semanticCommits",
    ":semanticCommitScopeDisabled"
  ],
  "baseBranchPatterns": ["$default"],
  "enabledManagers": [
    "bun",
    "bun-version",
    "nodenv",
    "github-actions",
    "custom.regex"
  ],
  "schedule": ["at any time"],
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "pruneStaleBranches": true,
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "labels": ["security"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Require approval before major update PR creation",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep engines.node floor manual per release runbook",
      "matchManagers": ["bun"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Group non-major devDependency updates",
      "matchManagers": ["bun"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "devDependencies"
    },
    {
      "description": "Keep release workflow changes manual",
      "matchFileNames": [".github/workflows/release.yml"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Keep custom release and CI tool updates manual",
      "matchManagers": ["custom.regex"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Track SHA-pinned GitHub Actions promptly",
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "GitHub Actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update npm CLI version used for release",
      "managerFilePatterns": [
        "/^\\.github/workflows\\/(?:ci|release)\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+- run: npm install -g npm@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update actionlint version used in CI and release validation",
      "managerFilePatterns": [
        "/^\\.github/workflows\\/(?:ci|release)\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+ACTIONLINT_VERSION: (?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ]
}
